{
  "name": "tack-browser",
  "version": "0.1.1",
  "productName": "Tack Browser",
  "private": true,
  "description": "Tack Browser for Mac: browse visual references, generate from style direction, and organize saved generations.",
  "main": "src/main.js",
  "homepage": "https://www.tack.design",
  "repository": {
    "type": "git",
    "url": "https://github.com/123415334/pinstyle-ai.git",
    "directory": "extension/tack-browser-app"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "ELECTRON_ENABLE_LOGGING=1 electron .",
    "package:mac": "electron-packager . \"Tack Browser\" --platform=darwin --arch=arm64 --out=out --overwrite --icon=build/tack.icns --app-bundle-id=com.tack.browser --app-version=$npm_package_version --build-version=$npm_package_version --asar --prune=true --ignore='^/(dist|out|.npm-cache|.github)(/|$)'",
    "package:mas": "electron-packager . \"Tack Browser\" --platform=mas --arch=arm64 --out=out-mas --overwrite --icon=build/tack.icns --app-bundle-id=com.tack.browser --app-version=$npm_package_version --build-version=$npm_package_version --asar --prune=true --ignore='^/(dist|out|out-mas|.npm-cache|.github)(/|$)'",
    "dist:mas": "bash scripts/package-mas.sh",
    "dist:mac": "bash scripts/package-mac.sh"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^42.4.1"
  }
}
