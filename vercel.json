{
  "functions": {
    "api/analyze.js": { "maxDuration": 300 },
    "api/create-checkout.js": { "maxDuration": 30 },
    "api/stripe-webhook.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/c",
      "destination": "https://chromewebstore.google.com/detail/tack/immnogdobhdocmmfceoeofjcmbohaobi",
      "permanent": true
    },
    {
      "source": "/chrome",
      "destination": "https://chromewebstore.google.com/detail/tack/immnogdobhdocmmfceoeofjcmbohaobi",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/a",         "destination": "/account.html" },
    { "source": "/n",         "destination": "/account.html" },
    { "source": "/account",   "destination": "/account.html" },
    { "source": "/whats-new", "destination": "/whats-new.html" },
    { "source": "/download",  "destination": "/download.html" },
    { "source": "/privacy",   "destination": "/privacy.html" },
    { "source": "/terms",     "destination": "/terms.html" },
    { "source": "/upgrade",   "destination": "/upgrade.html" },
    { "source": "/confirmed", "destination": "/confirmed.html" }
  ]
}
